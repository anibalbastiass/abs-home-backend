{
    "name": "abs-home-backend",
    "version": "1.2.1",
    "description": "ABS Smart Home IoT Gateway and Domain Control Plane",
    "main": "dist/server.js",
    "type": "commonjs",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc && tsc-alias",
        "start": "node dist/server.js",
        "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" --fix",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:unit": "vitest run \"src/**/*.spec.ts\"",
        "test:integration": "vitest run \"src/**/*.ispec.ts\"",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "spec:export": "tsx scripts/export-openapi.ts",
        "docs:start": "cd docs-site && npm run start -- --port 3001 --no-open",
        "docs:build": "cd docs-site && npm run build",
        "docs:serve": "cd docs-site && npm run serve -- --port 3001 --no-open",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:seed": "tsx prisma/seed.ts",
        "deploy:local": "docker compose up -d"
    },
    "keywords": [
        "smarthome",
        "iot",
        "koajs",
        "bullmq",
        "kafka",
        "prisma",
        "postgresql",
        "redis",
        "zod",
        "openapi"
    ],
    "author": "anibalbastias",
    "license": "MIT",
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^7.3.0",
        "@koa/cors": "^5.0.0",
        "@koa/router": "^13.1.0",
        "@prisma/client": "^5.22.0",
        "bullmq": "^5.41.0",
        "dotenv": "^16.4.7",
        "ioredis": "^5.4.2",
        "kafkajs": "^2.2.4",
        "koa": "^2.15.4",
        "koa-bodyparser": "^4.4.1",
        "koa-helmet": "^7.0.2",
        "pino": "^9.6.0",
        "pino-pretty": "^13.0.0",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.20.0",
        "@types/koa": "^2.15.0",
        "@types/koa__cors": "^5.0.0",
        "@types/koa__router": "^12.0.4",
        "@types/koa-bodyparser": "^4.3.12",
        "@types/node": "^22.13.4",
        "@types/supertest": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^8.24.1",
        "@typescript-eslint/parser": "^8.24.1",
        "@vitest/coverage-v8": "^3.0.6",
        "eslint": "^9.20.1",
        "prisma": "^5.22.0",
        "supertest": "^7.0.0",
        "tsc-alias": "^1.9.5",
        "tsx": "^4.19.3",
        "typescript": "^5.7.3",
        "vitest": "^3.0.6"
    }
}
